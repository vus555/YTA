<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
    <title>ПЕРЕКУП</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --status-height: 28px;
            --nav-height: 48px;
            --gold: #ffd700;
            --green: #4ecca3;
            --blue: #3a86ff;
            --accent: #e94560;
            --text: #fff;
            --text-dim: #888;
            --card: #1a1a30;
            --border: #2a2a4a;
            --bg: #0d0d1a;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            background: var(--bg);
            user-select: none;
            -webkit-user-select: none;
            display: flex;
            flex-direction: column;
            position: fixed;
            inset: 0;
        }

        /* ============ СТАТУС-БАР ============ */
        #status-bar {
            height: var(--status-height);
            background: #0a0a0f;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 15px;
            font-size: 0.7em;
            color: #fff;
            flex-shrink: 0;
            z-index: 100;
        }

        .sb-left {
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .sb-right {
            display: flex;
            gap: 8px;
            align-items: center;
            font-size: 0.7em;
        }

        .sb-battery {
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .batt-body {
            width: 20px;
            height: 10px;
            border: 1px solid #fff;
            border-radius: 2px;
            padding: 1px;
            display: flex;
            align-items: center;
        }

        .batt-fill {
            height: 100%;
            background: var(--green);
            border-radius: 1px;
        }

        .batt-tip {
            width: 2px;
            height: 4px;
            background: #fff;
            border-radius: 0 1px 1px 0;
        }

        /* ============ ЭКРАН ============ */
        #screen {
            flex: 1;
            background: var(--bg);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ============ ДОМАШНИЙ ЭКРАН ============ */
        .home-screen {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 40px 20px 20px 20px;
            background: 
                radial-gradient(ellipse at 30% 20%, rgba(58,134,255,0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 60%, rgba(233,69,96,0.06) 0%, transparent 50%),
                linear-gradient(180deg, #1a1a2e 0%, #0d0d1a 40%, #0a0a15 100%);
        }

        .home-clock {
            text-align: center;
            margin-bottom: 50px;
        }

        .home-clock .time {
            font-size: 2.5em;
            font-weight: bold;
            color: #fff;
            letter-spacing: 3px;
            text-shadow: 0 0 30px rgba(255,255,255,0.2);
        }

        .home-clock .date {
            font-size: 0.8em;
            color: var(--text-dim);
            margin-top: 5px;
        }

        .app-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            flex: 1;
            align-content: start;
        }

        .app-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            padding: 5px;
            border-radius: 14px;
            position: relative;
            transition: transform 0.1s;
        }

        .app-icon:active {
            transform: scale(0.88);
        }

        .icon-circle {
            width: 55px;
            height: 55px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7em;
            box-shadow: 0 6px 20px rgba(0,0,0,0.5);
            transition: transform 0.1s;
        }

        .app-icon:active .icon-circle {
            transform: scale(0.92);
        }

        .app-name {
            font-size: 0.6em;
            color: #fff;
            text-align: center;
            letter-spacing: 0.3px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.8);
        }

        .badge {
            position: absolute;
            top: -2px;
            right: 2px;
            background: #ff4757;
            color: #fff;
            font-size: 0.55em;
            font-weight: bold;
            min-width: 16px;
            height: 16px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 1.5px solid #0d0d1a;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.12); }
        }

        .icon-market { background: linear-gradient(135deg, #ff6b6b, #e94560); }
        .icon-inventory { background: linear-gradient(135deg, #4ecca3, #2ecc71); }
        .icon-chat { background: linear-gradient(135deg, #3a86ff, #1e5fd6); }
        .icon-bank { background: linear-gradient(135deg, #ffd700, #f0a500); }

        /* ============ ЭКРАНЫ ПРИЛОЖЕНИЙ ============ */
        .app-screen {
            display: none;
            flex-direction: column;
            height: 100%;
            background: var(--bg);
            position: absolute;
            inset: 0;
            z-index: 10;
            animation: slideIn 0.2s ease-out;
        }

        .app-screen.active {
            display: flex;
        }

        @keyframes slideIn {
            from { transform: translateX(30px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .app-header {
            background: #0a0a0f;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .back-arrow {
            font-size: 1.2em;
            color: var(--blue);
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 8px;
            background: none;
            border: none;
            transition: background 0.15s;
        }

        .back-arrow:active {
            background: rgba(255,255,255,0.1);
        }

        .app-title {
            font-size: 1em;
            font-weight: bold;
            color: #fff;
        }

        .app-body {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            -webkit-overflow-scrolling: touch;
        }

        .app-body::-webkit-scrollbar {
            width: 2px;
        }

        .app-body::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 2px;
        }

        /* ============ БАЛАНС ============ */
        .balance-banner {
            background: linear-gradient(135deg, #1a1a35, #0d0d25);
            border-radius: 14px;
            padding: 18px;
            text-align: center;
            margin-bottom: 10px;
            border: 1px solid var(--border);
        }

        .balance-banner .label {
            font-size: 0.65em;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .balance-banner .amount {
            font-size: 2em;
            font-weight: bold;
            color: var(--gold);
            margin-top: 5px;
        }

        /* ============ КАРТОЧКИ ============ */
        .card {
            background: var(--card);
            border-radius: 12px;
            padding: 14px;
            margin: 8px 0;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.15s;
        }

        .card:active {
            transform: scale(0.97);
            border-color: var(--gold);
        }

        .card .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card .model {
            font-weight: bold;
            color: #fff;
            font-size: 0.9em;
        }

        .card .price {
            font-weight: bold;
            color: var(--green);
            font-size: 1em;
        }

        .card .sub {
            font-size: 0.7em;
            color: var(--text-dim);
            margin-top: 4px;
        }

        /* ============ КНОПКИ ============ */
        .btn {
            display: inline-block;
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 11px 16px;
            border-radius: 9px;
            cursor: pointer;
            font-size: 0.75em;
            font-weight: bold;
            letter-spacing: 0.5px;
            transition: all 0.12s;
            text-transform: uppercase;
            margin: 2px;
            text-align: center;
        }

        .btn:active {
            transform: scale(0.92);
        }

        .btn:disabled {
            background: #252525;
            color: #555;
            cursor: not-allowed;
        }

        .btn-green { background: var(--green); color: #111; }
        .btn-blue { background: var(--blue); }
        .btn-gold { background: var(--gold); color: #111; }
        .btn-red { background: #ff4757; }
        .btn-gray { background: #3a3a3a; }
        .btn-block { display: block; width: 100%; margin: 5px 0; }

        /* ============ СООБЩЕНИЯ ============ */
        .msg {
            background: #15152a;
            border-radius: 12px;
            padding: 13px;
            margin: 8px 0;
            border-left: 3px solid var(--blue);
            animation: msgIn 0.2s ease-out;
        }

        @keyframes msgIn {
            from { transform: translateY(-10px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .msg .buyer {
            font-weight: bold;
            color: var(--gold);
            font-size: 0.75em;
        }

        .msg .text {
            font-size: 0.8em;
            color: #ccc;
            margin-top: 5px;
            font-style: italic;
        }

        .msg .offer {
            font-size: 0.9em;
            font-weight: bold;
            color: var(--green);
            margin-top: 5px;
        }

        /* ============ МОДАЛКА ============ */
        .modal-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-box {
            background: var(--card);
            border-radius: 18px;
            padding: 22px;
            width: 88%;
            max-width: 340px;
            text-align: center;
            animation: popIn 0.15s ease-out;
        }

        @keyframes popIn {
            from { transform: scale(0.85); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .modal-box h3 {
            color: var(--gold);
            font-size: 1.1em;
            margin-bottom: 10px;
        }

        .modal-box input {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 2px solid var(--border);
            background: #0a0a1a;
            color: #fff;
            font-size: 1em;
            text-align: center;
            margin: 10px 0;
        }

        .modal-box input:focus {
            border-color: var(--gold);
            outline: none;
        }

        /* ============ ТОСТ ============ */
        .toast {
            position: absolute;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%);
            background: #222;
            border-radius: 20px;
            padding: 11px 22px;
            color: #fff;
            font-size: 0.75em;
            z-index: 300;
            animation: toastIn 0.25s ease-out;
            box-shadow: 0 6px 25px rgba(0,0,0,0.8);
            white-space: nowrap;
            max-width: 88%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @keyframes toastIn {
            from { transform: translateX(-50%) translateY(50px); opacity: 0; }
            to { transform: translateX(-50%) translateY(0); opacity: 1; }
        }

        /* ============ НИЖНЯЯ НАВИГАЦИЯ ============ */
        #nav-bar {
            height: var(--nav-height);
            background: #0a0a0f;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 0 60px;
            flex-shrink: 0;
            border-top: 1px solid #1a1a1a;
            z-index: 100;
        }

        .nav-btn {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: none;
            border: none;
            border-radius: 50%;
            transition: all 0.12s;
        }

        .nav-btn:active {
            transform: scale(0.8);
            background: rgba(255,255,255,0.08);
        }

        .nav-triangle {
            width: 0;
            height: 0;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            border-bottom: 11px solid #888;
            transform: rotate(-90deg);
            display: inline-block;
            transition: border-color 0.12s;
        }

        .nav-btn:active .nav-triangle {
            border-bottom-color: #fff;
        }

        .nav-square {
            width: 11px;
            height: 11px;
            border: 2px solid #888;
            border-radius: 2px;
            display: inline-block;
            transition: border-color 0.12s;
        }

        .nav-btn:active .nav-square {
            border-color: #fff;
        }

        .nav-circle {
            width: 11px;
            height: 11px;
            border: 2px solid #888;
            border-radius: 50%;
            display: inline-block;
            transition: border-color 0.12s;
        }

        .nav-btn:active .nav-circle {
            border-color: #fff;
        }

        .no-items {
            text-align: center;
            color: var(--text-dim);
            font-size: 0.75em;
            padding: 30px 10px;
        }
    </style>
</head>
<body>
    <!-- ВЕРХНЯЯ ЧЁРНАЯ ЛИНИЯ: СТАТУС-БАР -->
    <div id="status-bar">
        <div class="sb-left" id="status-time">12:00</div>
        <div class="sb-right">
            <span>📶</span>
            <span>LTE</span>
            <div class="sb-battery">
                <div class="batt-body">
                    <div class="batt-fill" style="width:82%;"></div>
                </div>
                <div class="batt-tip"></div>
            </div>
        </div>
    </div>

    <!-- ОСНОВНОЙ ЭКРАН -->
    <div id="screen">
        <!-- ДОМАШНИЙ ЭКРАН -->
        <div id="home-screen" class="home-screen">
            <div class="home-clock">
                <div class="time" id="home-time">12:00</div>
                <div class="date" id="home-date">Понедельник, 1 января</div>
            </div>
            <div class="app-grid">
                <div class="app-icon" onclick="openApp('market')">
                    <div class="icon-circle icon-market">🛒</div>
                    <span class="app-name">Маркет</span>
                    <div class="badge" id="badge-market" style="display:none;">0</div>
                </div>
                <div class="app-icon" onclick="openApp('inventory')">
                    <div class="icon-circle icon-inventory">📦</div>
                    <span class="app-name">Инвентарь</span>
                </div>
                <div class="app-icon" onclick="openApp('chat')">
                    <div class="icon-circle icon-chat">💬</div>
                    <span class="app-name">Чаты</span>
                    <div class="badge" id="badge-chat" style="display:none;">0</div>
                </div>
                <div class="app-icon" onclick="openApp('bank')">
                    <div class="icon-circle icon-bank">💳</div>
                    <span class="app-name">Баланс</span>
                </div>
            </div>
        </div>

        <!-- ПРИЛОЖЕНИЕ: МАРКЕТ -->
        <div id="app-market" class="app-screen">
            <div class="app-header">
                <button class="back-arrow" onclick="closeApp()">←</button>
                <span class="app-title">Маркет</span>
            </div>
            <div class="app-body">
                <div class="balance-banner">
                    <div class="label">Баланс</div>
                    <div class="amount" id="market-balance">0 ₽</div>
                </div>
                <button class="btn btn-blue btn-block" onclick="refreshMarket()">🔄 Обновить</button>
                <div id="market-list"></div>
            </div>
        </div>

        <!-- ПРИЛОЖЕНИЕ: ИНВЕНТАРЬ -->
        <div id="app-inventory" class="app-screen">
            <div class="app-header">
                <button class="back-arrow" onclick="closeApp()">←</button>
                <span class="app-title">Инвентарь</span>
            </div>
            <div class="app-body">
                <div id="inventory-list"></div>
            </div>
        </div>

        <!-- ПРИЛОЖЕНИЕ: ЧАТЫ -->
        <div id="app-chat" class="app-screen">
            <div class="app-header">
                <button class="back-arrow" onclick="closeApp()">←</button>
                <span class="app-title">Сообщения</span>
            </div>
            <div class="app-body">
                <div id="chat-list"></div>
            </div>
        </div>

        <!-- ПРИЛОЖЕНИЕ: БАЛАНС -->
        <div id="app-bank" class="app-screen">
            <div class="app-header">
                <button class="back-arrow" onclick="closeApp()">←</button>
                <span class="app-title">Баланс</span>
            </div>
            <div class="app-body">
                <div class="balance-banner">
                    <div class="label">Текущий баланс</div>
                    <div class="amount" id="bank-balance">0 ₽</div>
                </div>
                <button class="btn btn-green btn-block" onclick="nextDay()">📅 Следующий день</button>
                <div id="bank-log" style="font-size:0.7em;color:var(--text-dim);margin-top:15px;"></div>
            </div>
        </div>

        <!-- МОДАЛКА -->
        <div id="modal" class="modal-overlay">
            <div class="modal-box" id="modal-content"></div>
        </div>

        <!-- ТОСТ -->
        <div id="toast" class="toast" style="display:none;"></div>
    </div>

    <!-- НИЖНЯЯ ЧЁРНАЯ ЛИНИЯ: НАВИГАЦИЯ -->
    <div id="nav-bar">
        <button class="nav-btn" onclick="navBack()">
            <span class="nav-triangle"></span>
        </button>
        <button class="nav-btn" onclick="navHome()">
            <span class="nav-circle"></span>
        </button>
        <button class="nav-btn" onclick="navRecent()">
            <span class="nav-square"></span>
        </button>
    </div>

    <script>
        // ==================== ДАННЫЕ ====================
        const phones = [
            { model: "iPhone X", base: 15000 },
            { model: "iPhone 11", base: 22000 },
            { model: "iPhone 12", base: 30000 },
            { model: "iPhone 13", base: 42000 },
            { model: "Samsung S20", base: 18000 },
            { model: "Samsung S21", base: 25000 },
            { model: "Xiaomi 10", base: 12000 },
            { model: "Pixel 5", base: 20000 },
            { model: "Huawei P30", base: 14000 },
            { model: "OnePlus 8", base: 17000 }
        ];

        const conditions = ["Отличное", "Хорошее", "Среднее", "Потёртый"];
        const condMult = { "Отличное": 1.0, "Хорошее": 0.85, "Среднее": 0.7, "Потёртый": 0.5 };
        const buyers = ["Андрей", "Дима", "Макс", "Сергей", "Влад", "Игорь", "Никита", "Паша", "Тимур", "Артур"];
        const sellers = ["Катя", "Женя", "Марина", "Витя", "Олег", "Света", "Коля"];

        let state = {
            balance: 5000,
            day: 1,
            inventory: [],
            market: [],
            chats: [],
            selected: -1,
            log: []
        };

        let currentApp = null;

        // ==================== УТИЛИТЫ ====================
        function r(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
        function fmt(n) { return n.toLocaleString('ru-RU') + ' ₽'; }

        function toast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.style.display = 'block';
            clearTimeout(t._t);
            t._t = setTimeout(() => t.style.display = 'none', 1800);
            if (navigator.vibrate) navigator.vibrate(15);
        }

        function updateClock() {
            const now = new Date();
            const time = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            document.getElementById('status-time').textContent = time;
            document.getElementById('home-time').textContent = time;
            const months = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
            const days = ['Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота'];
            document.getElementById('home-date').textContent = days[now.getDay()] + ', ' + now.getDate() + ' ' + months[now.getMonth()];
        }
        setInterval(updateClock, 1000);
        updateClock();

        function genPhone() {
            const d = phones[r(0, phones.length - 1)];
            const c = conditions[r(0, conditions.length - 1)];
            return {
                id: Date.now() + Math.random(),
                model: d.model,
                condition: c,
                price: Math.round(d.base * condMult[c]),
                paid: 0,
                forSale: false,
                listedPrice: null
            };
        }

        function genListings(n) {
            const arr = [];
            for (let i = 0; i < n; i++) {
                const p = genPhone();
                p.price = Math.round(p.price * (0.75 + Math.random() * 0.5));
                p.seller = sellers[r(0, sellers.length - 1)];
                arr.push(p);
            }
            return arr;
        }

        function genChat(p) {
            const buyer = buyers[r(0, buyers.length - 1)];
            const offer = Math.round((p.listedPrice || p.price) * (0.7 + Math.random() * 0.4));
            const texts = [
                "Здравствуйте, ещё продаётся?",
                "Могу забрать сегодня",
                "Оригинал? Не подделка?",
                "Есть царапины?",
                "Аккумулятор как держит?",
                "Скиньте фото",
                "Почему так дёшево?",
                "Торг уместен?"
            ];
            return {
                id: Date.now() + Math.random(),
                buyer: buyer,
                phoneId: p.id,
                phoneModel: p.model,
                offer: offer,
                text: texts[r(0, texts.length - 1)]
            };
        }

        function addLog(msg) {
            state.log.push(msg);
            if (state.log.length > 50) state.log.shift();
        }

        function updateBadges() {
            const bm = document.getElementById('badge-market');
            const bc = document.getElementById('badge-chat');
            bm.style.display = state.market.length > 0 ? 'flex' : 'none';
            bm.textContent = state.market.length;
            bc.style.display = state.chats.length > 0 ? 'flex' : 'none';
            bc.textContent = state.chats.length;
        }

        // ==================== НАВИГАЦИЯ ====================
        function openApp(app) {
            document.getElementById('home-screen').style.display = 'none';
            document.querySelectorAll('.app-screen').forEach(el => el.classList.remove('active'));
            document.getElementById('app-' + app).classList.add('active');
            currentApp = app;
            renderApp(app);
            if (navigator.vibrate) navigator.vibrate(10);
        }

        function closeApp() {
            document.querySelectorAll('.app-screen').forEach(el => el.classList.remove('active'));
            document.getElementById('home-screen').style.display = 'flex';
            currentApp = null;
            if (navigator.vibrate) navigator.vibrate(10);
        }

        function navBack() {
            if (currentApp) closeApp();
            else toast('Вы на главном экране');
        }

        function navHome() {
            closeApp();
            if (navigator.vibrate) navigator.vibrate([20, 30, 20]);
        }

        function navRecent() {
            toast('🔄 Недавние приложения');
            if (navigator.vibrate) navigator.vibrate(20);
        }

        function renderApp(app) {
            if (app === 'market') renderMarket();
            else if (app === 'inventory') renderInventory();
            else if (app === 'chat') renderChat();
            else if (app === 'bank') renderBank();
        }

        // ==================== МАРКЕТ ====================
        function renderMarket() {
            document.getElementById('market-balance').textContent = fmt(state.balance);
            const el = document.getElementById('market-list');
            if (state.market.length === 0) {
                el.innerHTML = '<div class="no-items">📭 Пусто. Обновите ленту</div>';
                return;
            }
            el.innerHTML = state.market.map((p, i) => `
                <div class="card">
                    <div class="row">
                        <span class="model">📱 ${p.model}</span>
                        <span class="price">${fmt(p.price)}</span>
                    </div>
                    <div class="sub">${p.condition} | ${p.seller}</div>
                    <div style="margin-top:8px;display:flex;gap:4px;">
                        <button class="btn btn-green" ${state.balance >= p.price ? '' : 'disabled'} onclick="buyPhone(${i})">Купить</button>
                        <button class="btn btn-gold" onclick="negotiate(${i})">💬 Торг</button>
                    </div>
                </div>
            `).join('');
        }

        function refreshMarket() {
            state.market = genListings(r(5, 9));
            toast('🔄 Обновлено');
            renderMarket();
            updateBadges();
        }

        function buyPhone(i) {
            const p = state.market[i];
            if (state.balance < p.price) { toast('❌ Недостаточно!'); return; }
            state.balance -= p.price;
            p.paid = p.price;
            p.forSale = false;
            p.listedPrice = null;
            state.inventory.push(p);
            state.market.splice(i, 1);
            addLog('✅ Куплен ' + p.model + ' за ' + fmt(p.price));
            toast('✅ Куплен ' + p.model);
            if (navigator.vibrate) navigator.vibrate([30, 50, 30]);
            renderMarket();
            updateBadges();
        }

        function negotiate(i) {
            const p = state.market[i];
            const min = Math.round(p.price * 0.7);
            const modal = document.getElementById('modal');
            const content = document.getElementById('modal-content');
            content.innerHTML = `
                <h3>💬 Торг с ${p.seller}</h3>
                <p style="font-size:0.85em;color:#ccc;">${p.model} (${p.condition})</p>
                <p style="margin:8px 0;">Цена: <strong style="color:var(--gold)">${fmt(p.price)}</strong></p>
                <input type="number" id="nego-input" min="${min}" max="${p.price}" value="${Math.round((min + p.price) / 2)}">
                <br><br>
                <button class="btn btn-green" onclick="sendNego(${i})">Отправить</button>
                <button class="btn btn-gray" onclick="closeModal()">Отмена</button>
            `;
            modal.classList.add('active');
        }

        function sendNego(i) {
            const inp = document.getElementById('nego-input');
            const val = parseInt(inp.value);
            const p = state.market[i];
            if (isNaN(val) || val < Math.round(p.price * 0.7) || val > p.price) {
                toast('❌ Неверная сумма');
                return;
            }
            closeModal();
            if (Math.random() < val / p.price) {
                p.price = val;
                toast('✅ ' + p.seller + ' согласился!');
                addLog('💬 ' + p.seller + ' согласился на ' + fmt(val));
            } else {
                p.price = Math.round(p.price * 0.85);
                toast('❌ ' + p.seller + ' отказался');
                addLog('💬 ' + p.seller + ': минимум ' + fmt(p.price));
            }
            renderMarket();
        }

        function closeModal() {
            document.getElementById('modal').classList.remove('active');
        }

        // ==================== ИНВЕНТАРЬ ====================
        function renderInventory() {
            const el = document.getElementById('inventory-list');
            if (state.inventory.length === 0) {
                el.innerHTML = '<div class="no-items">📦 Инвентарь пуст</div>';
                return;
            }
            el.innerHTML = state.inventory.map((p, i) => {
                const sel = state.selected === i ? 'border-color:var(--green);' : '';
                return `
                    <div class="card" style="${sel}" onclick="selectPhone(${i})">
                        <div class="row">
                            <span class="model">📱 ${p.model}</span>
                            <span style="font-size:0.65em;color:${p.forSale ? 'var(--green)' : 'var(--gold)'}">${p.forSale ? 'Продаётся' : 'Не выставлен'}</span>
                        </div>
                        <div class="sub">${p.condition} | Куплен: ${fmt(p.paid || 0)}</div>
                        ${p.forSale ? '<div style="color:var(--green);font-weight:bold;margin-top:4px;">' + fmt(p.listedPrice) + '</div>' : ''}
                    </div>
                `;
            }).join('');
            
            if (state.selected >= 0 && state.selected < state.inventory.length) {
                const p = state.inventory[state.selected];
                el.innerHTML += p.forSale 
                    ? '<button class="btn btn-gray btn-block" onclick="unlistPhone()">📥 Снять с продажи</button>'
                    : '<button class="btn btn-green btn-block" onclick="listPhone()">📤 Выставить на продажу</button>';
            }
        }

        function selectPhone(i) {
            state.selected = i;
            renderInventory();
            if (navigator.vibrate) navigator.vibrate(10);
        }

        function listPhone() {
            const p = state.inventory[state.selected];
            const d = phones.find(x => x.model === p.model);
            p.listedPrice = Math.round(d.base * condMult[p.condition] * (0.9 + Math.random() * 0.2));
            p.forSale = true;
            addLog('📤 ' + p.model + ' выставлен за ' + fmt(p.listedPrice));
            const msg = genChat(p);
            state.chats.push(msg);
            addLog('💬 ' + msg.buyer + ' написал');
            toast('📤 Выставлен!');
            renderInventory();
            updateBadges();
        }

        function unlistPhone() {
            const p = state.inventory[state.selected];
            p.forSale = false;
            p.listedPrice = null;
            addLog('📥 ' + p.model + ' снят с продажи');
            toast('📥 Снят');
            renderInventory();
        }

        // ==================== ЧАТЫ ====================
        function renderChat() {
            const el = document.getElementById('chat-list');
            if (state.chats.length === 0) {
                el.innerHTML = '<div class="no-items">💬 Нет сообщений</div>';
                return;
            }
            el.innerHTML = state.chats.map((m, i) => {
                const exists = state.inventory.some(p => p.id === m.phoneId);
                return `
                    <div class="msg">
                        <div class="buyer">👤 ${m.buyer}</div>
                        <div class="text">"${m.text}"</div>
                        <div class="offer">${fmt(m.offer)} за ${m.phoneModel}</div>
                        ${exists ? `
                            <div style="margin-top:8px;display:flex;gap:4px;">
                                <button class="btn btn-green" onclick="acceptChat(${i})">✅ Принять</button>
                                <button class="btn btn-red" onclick="declineChat(${i})">❌</button>
                            </div>
                        ` : '<div style="font-size:0.7em;color:var(--text-dim);margin-top:4px;">📱 Телефон продан</div>'}
                    </div>
                `;
            }).join('');
        }

        function acceptChat(i) {
            const m = state.chats[i];
            const idx = state.inventory.findIndex(p => p.id === m.phoneId);
            if (idx === -1) { state.chats.splice(i, 1); renderChat(); return; }
            state.balance += m.offer;
            state.inventory.splice(idx, 1);
            state.chats.splice(i, 1);
            if (state.selected >= state.inventory.length) state.selected = -1;
            addLog('✅ Продан ' + m.phoneModel + ' за ' + fmt(m.offer));
            toast('✅ +' + fmt(m.offer));
            if (navigator.vibrate) navigator.vibrate([40, 30, 40]);
            renderChat();
            updateBadges();
        }

        function declineChat(i) {
            const m = state.chats[i];
            addLog('❌ Отклонено: ' + m.buyer);
            state.chats.splice(i, 1);
            toast('❌ Отклонено');
            renderChat();
            updateBadges();
        }

        // ==================== БАНК ====================
        function renderBank() {
            document.getElementById('bank-balance').textContent = fmt(state.balance);
            document.getElementById('bank-log').innerHTML = state.log.slice(-20).reverse().map(msg =>
                '<div style="padding:4px 0;border-bottom:1px solid var(--border);">' + msg + '</div>'
            ).join('');
        }

        function nextDay() {
            state.day++;
            state.market = genListings(r(5, 10));
            state.inventory.forEach(p => {
                if (p.forSale && Math.random() > 0.4) {
                    const m = genChat(p);
                    state.chats.push(m);
                    addLog('💬 ' + m.buyer + ' написал');
                }
            });
            if (Math.random() > 0.6) {
                const e = r(1, 3);
                if (e === 1) {
                    const b = r(500, 2000);
                    state.balance += b;
                    addLog('🎁 Подработка: +' + fmt(b));
                    toast('🎁 +' + fmt(b));
                } else if (e === 2) {
                    const p = r(300, 1000);
                    state.balance = Math.max(0, state.balance - p);
                    addLog('💸 Расходы: -' + fmt(p));
                    toast('💸 -' + fmt(p));
                } else {
                    state.market.forEach(p => p.price = Math.round(p.price * (0.9 + Math.random() * 0.2)));
                    addLog('📰 Цены изменились');
                    toast('📰 Цены изменились');
                }
            }
            toast('📅 День ' + state.day);
            renderApp(currentApp);
            updateBadges();
        }

        // ==================== ИНИЦИАЛИЗАЦИЯ ====================
        function init() {
            const first = genPhone();
            first.condition = "Хорошее";
            first.price = 0;
            first.paid = 0;
            first.forSale = true;
            const d = phones.find(x => x.model === first.model);
            first.listedPrice = Math.round(d.base * 0.8);
            state.inventory.push(first);
            state.market = genListings(7);
            
            const msg = genChat(first);
            state.chats.push(msg);
            
            addLog('🎮 Начало игры');
            addLog('📱 ' + first.model + ' выставлен за ' + fmt(first.listedPrice));
            addLog('💬 ' + msg.buyer + ' написал');
            
            updateBadges();
            toast('📱 Добро пожаловать!');
        }

        init();
    </script>
</body>
</html>
